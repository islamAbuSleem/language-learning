    { "es": "dentro", "en": "inside", "article": null, "note": "No article: está dentro.", "tags": ["place"] },
    { "es": "fuera", "en": "outside", "article": null, "note": "No article: está fuera.", "tags": ["place"] },
    { "es": "bajo", "en": "under", "article": null, "note": "No article: está bajo. It also means low.", "tags": ["place"] },
