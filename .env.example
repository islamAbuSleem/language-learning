# The Postgres connection string (Neon).
#
# Copy .env.example to .env and paste the real URL. .env is gitignored:
# never commit a credential.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Outgoing mail for magic sign-in links (optional).
#
# Without a key the app logs the link to the console instead of sending it,
# which is how local dev and the tests sign in. Set it for production.
#RESEND_API_KEY=re_xxx
#MAIL_FROM=Language App <hello@example.com>

# Google sign-in (optional).
#
# Create an OAuth client at console.cloud.google.com/apis/credentials
# (type: Web application), add {origin}/api/auth/google/callback as an
# authorised redirect URI, and paste the id and secret here. The Google
# button only appears once GOOGLE_CLIENT_ID is set. GOOGLE_REDIRECT_URL
# overrides the callback for setups behind a proxy; otherwise it defaults
# to the request's own origin.
#GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=xxx
#GOOGLE_REDIRECT_URL=https://example.com/api/auth/google/callback
