{
  "name": "language-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/progress/postgres.test.ts",
    "build:content": "node scripts/build-content.mjs",
    "build:audio": "node scripts/build-audio.mjs",
    "check:audio": "node scripts/build-audio.mjs --check",
    "import:audio": "node scripts/import-native-audio.mjs",
    "audit:path": "node scripts/audit-path.mjs",
    "check:content": "node scripts/check-content.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "postgres": "^4.1.1",
    "vue": "3.5.45",
    "vue-router": "^4.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@types/node": "^26.6.6",
    "lamejs": "^1.2.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
