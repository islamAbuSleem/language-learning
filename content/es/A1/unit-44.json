{
  "track": "es",
  "level": "A1",
  "unit": 44,
  "title": "Music and film",
  "description": "Name the things on a stage, and talk about what you watch and hear.",
  "explanation": {
    "summary": "Music and film have their own small set of nouns, and they are the words a learner needs to talk about what they watch and listen to.",
    "sections": [
      {
        "heading": "The nouns",
        "body": "El teatro, el concierto, el piano, el violín, el actor, el público y el programa are masculine. La guitarra, el baile y la actriz are feminine. El programa is the programme, and el público is the audience.",
        "examples": [
          {
            "es": "el concierto",
            "en": "the concert"
          },
          {
            "es": "la guitarra",
            "en": "the guitar"
          },
          {
            "es": "la actriz",
            "en": "the actress"
          }
        ]
      },
      {
        "heading": "Where the things are",
        "body": "You already know how to say where something is. El concierto está en el teatro, the concert is at the theatre. La guitarra está en la caja, the guitar is in the case. Es and está work as usual: el baile es bonito, the dance is beautiful, and el teatro está lleno, the theatre is full.",
        "examples": [
          {
            "es": "el concierto está en el teatro",
            "en": "the concert is at the theatre"
          },
          {
            "es": "el teatro está lleno",
            "en": "the theatre is full"
          },
          {
            "es": "la guitarra es de mi hermano",
            "en": "the guitar is my brother's"
          }
        ]
      }
    ]
  },
