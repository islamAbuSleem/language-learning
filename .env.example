# The Postgres connection string (Neon).
#
# Copy .env.example to .env and paste the real URL. .env is gitignored:
# never commit a credential.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Outgoing mail for magic sign-in links (optional).
#
# Without a key the app logs the link to the console instead of sending it,
# which is how local dev and the tests sign in. Set it for production.
#RESEND_API_KEY=re_xxx
#MAIL_FROM=Language App <hello@example.com>
