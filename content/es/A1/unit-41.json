{
  "track": "es",
  "level": "A1",
  "unit": 41,
  "title": "More colours",
  "description": "Name the colours you have not met yet, and use them with the verb ser.",
  "explanation": {
    "summary": "Colours are adjectives, and like every other adjective they change their ending to match the thing they describe. Most of them are the same word for men and women.",
    "sections": [
      {
        "heading": "The colours",
        "body": "Gris, turquesa and beis are the same in both genders. Amarillo, marrón, rosa, morado, dorado and claro become amarilla, marrón, rosa, morada, dorada and clara. Rosa is unusual: it does not change at all, and neither does it need an accent.",
        "examples": [
          {
            "es": "un coche gris",
            "en": "a grey car"
          },
          {
            "es": "una camisa amarilla",
            "en": "a yellow shirt"
          },
          {
            "es": "un libro marrón",
            "en": "a brown book"
          }
        ]
      },
      {
        "heading": "Where the colour goes",
        "body": "A colour goes straight after the noun, with no article: el queso es blanco, la pared es amarilla. When the colour comes first, it takes el or la like an adjective: el café está oscuro, la casa es blanca.",
        "examples": [
          {
            "es": "la pared es amarilla",
            "en": "the wall is yellow"
          },
          {
            "es": "el libro es marrón",
            "en": "the book is brown"
          },
          {
            "es": "la ciudad es gris",
            "en": "the city is grey"
          }
        ]
      }
    ]
  },
