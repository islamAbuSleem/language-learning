{
  "track": "es",
  "level": "A1",
  "unit": 39,
  "title": "The date and the year",
  "description": "Finish the year, and talk about birthdays and seasons.",
  "explanation": {
    "summary": "The last two months, and the words you need for a date, a birthday and a season. This is where the months finish and the seasons begin.",
    "sections": [
      {
        "heading": "The last two months",
        "body": "Noviembre and diciembre close the year, and they follow the rule of the others: no article. En noviembre, en diciembre. The date is la fecha, and it is feminine: la fecha es el 5 de noviembre.",
        "examples": [
          {
            "es": "en noviembre",
            "en": "in November"
          },
          {
            "es": "en diciembre",
            "en": "in December"
          },
          {
            "es": "la fecha es el 5 de noviembre",
            "en": "the date is the fifth of November"
          }
        ]
      },
      {
        "heading": "Birthdays and seasons",
        "body": "A birthday takes el: el cumpleaños is on the same day every year. The seasons take their article: la primavera, el otoño. The end of the year is el año nuevo, and the quiet days are el fin de semana.",
        "examples": [
          {
            "es": "el cumpleaños es en mayo",
            "en": "the birthday is in May"
          },
          {
            "es": "en primavera hace buen tiempo",
            "en": "in spring the weather is nice"
          },
          {
            "es": "el fin de semana es el sábado y el domingo",
            "en": "the weekend is Saturday and Sunday"
          }
        ]
      }
    ]
  },
