{
  "track": "es",
  "level": "A1",
  "unit": 33,
  "title": "The office",
  "description": "Name the things on a desk, and say what they are for.",
  "explanation": {
    "summary": "An office is a set of nouns, and each one has a job. Para is the word that explains what something is for.",
    "sections": [
      {
        "heading": "The nouns",
        "body": "El escritorio, el papel, el calendario, el archivo, el mostrador y el teclado are masculine. La carpeta, la grapadora, la agenda y la impresora are feminine. La agenda is the diary, and el archivo is the filing cabinet or the archive.",
        "examples": [
          {
            "es": "el escritorio",
            "en": "the desk"
          },
          {
            "es": "la carpeta",
            "en": "the folder"
          },
          {
            "es": "el teclado",
            "en": "the keyboard"
          }
        ]
      },
      {
        "heading": "What they are for",
        "body": "Para says what a thing is for, and it goes in front of the noun with its article: el papel es para escribir, the paper is for writing. En says where it is: el papel está en la carpeta, the paper is in the folder.",
        "examples": [
          {
            "es": "el papel es para escribir",
            "en": "the paper is for writing"
          },
          {
            "es": "el archivo está en la oficina",
            "en": "the filing cabinet is in the office"
          },
          {
            "es": "la agenda está encima del teclado",
            "en": "the diary is on top of the keyboard"
          }
        ]
      }
    ]
  },
