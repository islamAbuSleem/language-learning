{
  "track": "es",
  "level": "B1",
  "unit": 5,
  "title": "This, that, someone",
  "description": "Point at things, and talk about people without naming them.",
  "exercises": [
    {
      "id": "es/b1/u5/match/esto",
      "type": "match",
      "prompt": "Pair each word with its translation.",
      "pairs": [
        {
          "left": "this",
          "right": "esto"
        },
        {
          "left": "that",
          "right": "eso"
        },
        {
          "left": "that over there",
          "right": "aquello"
        },
        {
          "left": "someone",
          "right": "alguien"
        },
        {
          "left": "nobody",
          "right": "nadie"
        }
      ],
      "note": "These words stand in for a noun: eso es mi coche. Alguien and nadie work the same way."
    },
    {
      "id": "es/b1/u5/select/esto",
      "type": "select",
      "prompt": "Pick the Spanish word for “this”.",
      "options": [
        "nos",
        "os",
        "los",
        "esto"
      ],
      "answer": "esto",
      "translation": "this",
      "note": "This, close to the speaker. It never changes."
    },
    {
      "id": "es/b1/u5/type_in/eso",
